 "subs": [
  {
   "a": 1.6,
   "b": 2.45,
   "tx": "밤 11시."
  },
  {
   "a": 2.51,
   "b": 6.241,
   "tx": "시험은 내일인데, 눈꺼풀은 자꾸 무거워집니다."
  },
  {
   "a": 6.301,
   "b": 10.79,
   "tx": "그래서 우리는 책상 위에 초콜릿과 탄산음료를 올려두죠."
  },
  {
   "a": 10.85,
   "b": 14.885,
   "tx": "시험 기간, 집중력을 올리려고 먹은 달콤한 간식!"
  },
  {
   "a": 14.945,
   "b": 18.373,
   "tx": "그런데 왜 내 뇌는 더 졸리고 멍해질까요?"
  },
  {
   "a": 18.433,
   "b": 20.041,
   "tx": "분명 당을 채웠는데,"
  },
  {
   "a": 20.101,
   "b": 24.135,
   "tx": "30분 뒤 머릿속은 안개가 낀 것처럼 하얘집니다."
  },
  {
   "a": 24.195,
   "b": 28.837,
   "tx": "펜을 든 손은 멈춰 있고, 시계만 자꾸 확인하게 됩니다."
  },
  {
   "a": 28.897,
   "b": 32.476,
   "tx": "당이 모자라서 그런 거라고 생각하기 쉽지만,"
  },
  {
   "a": 32.536,
   "b": 34.144,
   "tx": "사실은 정반대입니다."
  },
  {
   "a": 34.204,
   "b": 36.722,
   "tx": "이건 의지력의 문제가 아닙니다."
  },
  {
   "a": 36.782,
   "b": 41.12,
   "tx": "범인은 바로 내 몸속 시한폭탄, 혈당 스파이크입니다."
  },
  {
   "a": 45.9,
   "b": 50.211,
   "tx": "설탕이 가득한 음식을 먹으면 혈당이 급상승합니다."
  },
  {
   "a": 50.271,
   "b": 55.068,
   "tx": "정제된 탄수화물과 단순당은 소화 과정을 거의 건너뛰고,"
  },
  {
   "a": 55.128,
   "b": 58.954,
   "tx": "순식간에 혈관 속 포도당 농도를 끌어올리죠."
  },
  {
   "a": 59.014,
   "b": 65.106,
   "tx": "깜짝 놀란 우리 몸은 인슐린을 마구 뿜어내어 혈당을 뚝 떨어뜨립니다."
  },
  {
   "a": 65.166,
   "b": 70.125,
   "tx": "췌장이 내보낸 인슐린은 포도당을 세포 안으로 밀어 넣죠."
  },
  {
   "a": 70.185,
   "b": 75.306,
   "tx": "문제는 인슐린이 필요한 양보다 과하게 분비된다는 점입니다."
  },
  {
   "a": 75.366,
   "b": 79.192,
   "tx": "그래서 혈당은 제자리로 돌아오는 게 아니라,"
