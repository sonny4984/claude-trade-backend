  {
   "a": 105.2,
   "b": 107.152,
   "tx": "한 걸음 더 들어가볼까요?"
  },
  {
   "a": 107.212,
   "b": 112.325,
   "tx": "우리 뇌의 시상하부에는 깨어있게 만드는 오렉신 스위치가 있습니다."
  },
  {
   "a": 112.385,
   "b": 114.911,
   "tx": "각성과 집중을 켜두는 신경세포죠."
