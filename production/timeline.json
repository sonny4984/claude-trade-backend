  {
   "a": 100.33,
   "b": 103.52,
   "tx": "이것이 바로 가짜 피로, 혈당 크래시입니다."
  },
  {
   "a": 105.9,
   "b": 107.762,
   "tx": "한 걸음 더 들어가볼까요?"
  },
  {
   "a": 107.822,
   "b": 112.705,
   "tx": "우리 뇌의 시상하부에는 깨어있게 만드는 오렉신 스위치가 있습니다."
  },
  {
   "a": 112.765,
   "b": 115.176,
   "tx": "각성과 집중을 켜두는 신경세포죠."
