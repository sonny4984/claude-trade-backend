  {
   "a": 79.252,
   "b": 82.43,
   "tx": "출발점보다 더 아래로 곤두박질칩니다."
  },
  {
   "a": 82.49,
   "b": 86.963,
   "tx": "이때 연료를 빼앗긴 뇌 세포는 비명을 지르게 됩니다."
  },
  {
   "a": 87.023,
   "b": 89.715,
   "tx": "뇌는 몸무게의 단 2%지만,"
  },
  {
   "a": 89.775,
   "b": 94.734,
   "tx": "우리가 쓰는 에너지의 20%를 소비하는 기관이니까요."
