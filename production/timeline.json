  {
   "a": 101.269,
   "b": 104.54,
   "tx": "이것이 바로 가짜 피로, 혈당 크래시입니다."
  },
  {
   "a": 105.2,
   "b": 107.156,
   "tx": "한 걸음 더 들어가볼까요?"
  },
  {
   "a": 107.216,
   "b": 112.341,
   "tx": "우리 뇌의 시상하부에는 깨어있게 만드는 오렉신 스위치가 있습니다."
  },
  {
   "a": 112.401,
   "b": 114.933,
   "tx": "각성과 집중을 켜두는 신경세포죠."
