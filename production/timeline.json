  {
   "a": 94.794,
   "b": 98.62,
   "tx": "이것이 바로 가짜 피로, 혈당 크래시입니다."
  },
  {
   "a": 105.9,
   "b": 108.057,
   "tx": "한 걸음 더 들어가볼까요?"
  },
  {
   "a": 108.117,
   "b": 113.758,
   "tx": "우리 뇌의 시상하부에는 깨어있게 만드는 오렉신 스위치가 있습니다."
  },
  {
   "a": 113.818,
   "b": 116.608,
   "tx": "각성과 집중을 켜두는 신경세포죠."
  },
  {
   "a": 116.668,
   "b": 121.992,
   "tx": "하지만 포도당이 급격히 많아지면 이 스위치는 강제로 꺼집니다."
  },
  {
   "a": 122.052,
   "b": 128.009,
   "tx": "세포 연구에서도 포도당이 늘자 오렉신의 활성은 뚜렷하게 억제됐습니다."
  },
  {
   "a": 128.069,
   "b": 134.66,
   "tx": "잠을 조절하지 못하는 기면증 환자에게서 바로 이 오렉신 세포가 사라져 있죠."
  },
  {
   "a": 134.72,
   "b": 140.044,
   "tx": "반면 완만하게 소화되는 통곡물이나 견과류는 오렉신을 안정적으로"
  },
  {
   "a": 140.104,
   "b": 141.311,
   "tx": "유지해 줍니다."
  },
  {
   "a": 141.371,
   "b": 146.22,
   "tx": "같은 열량이라도, 혈당 곡선의 모양이 집중력을 가릅니다."
