  {
   "a": 105.9,
   "b": 107.653,
   "tx": "한 걸음 더 들어가볼까요?"
  },
  {
   "a": 107.713,
   "b": 112.314,
   "tx": "우리 뇌의 시상하부에는 깨어있게 만드는 오렉신 스위치가 있습니다."
  },
  {
   "a": 112.374,
   "b": 114.645,
   "tx": "각성과 집중을 켜두는 신경세포죠."
