  {
   "a": 35.405,
   "b": 37.038,
   "tx": "사실은 정반대입니다."
  },
  {
   "a": 37.098,
   "b": 39.656,
   "tx": "이건 의지력의 문제가 아닙니다."
  },
  {
   "a": 39.716,
   "b": 44.12,
   "tx": "범인은 바로 내 몸속 시한폭탄, 혈당 스파이크입니다."
  },
  {
   "a": 46.9,
   "b": 51.236,
   "tx": "설탕이 가득한 음식을 먹으면 혈당이 급상승합니다."
  },
  {
   "a": 51.296,
   "b": 56.121,
   "tx": "정제된 탄수화물과 단순당은 소화 과정을 거의 건너뛰고,"
  },
  {
   "a": 56.181,
   "b": 60.029,
   "tx": "순식간에 혈관 속 포도당 농도를 끌어올리죠."
  },
  {
   "a": 60.089,
   "b": 66.216,
   "tx": "깜짝 놀란 우리 몸은 인슐린을 마구 뿜어내어 혈당을 뚝 떨어뜨립니다."
  },
  {
   "a": 66.276,
   "b": 71.263,
   "tx": "췌장이 내보낸 인슐린은 포도당을 세포 안으로 밀어 넣죠."
  },
  {
   "a": 71.323,
   "b": 76.474,
   "tx": "문제는 인슐린이 필요한 양보다 과하게 분비된다는 점입니다."
  },
  {
   "a": 76.534,
   "b": 80.381,
   "tx": "그래서 혈당은 제자리로 돌아오는 게 아니라,"
