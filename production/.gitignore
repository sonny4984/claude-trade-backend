# 재생성 가능한 대용량 산출물은 저장소에 넣지 않는다
fonts/
stills/
hero_raw.png
out/*.mp4
out/*.png
out/*.mp3
out/render.log
out/diagnose.log

# 나레이션 원본은 크레딧 소진으로 재생성이 불가능하다.
# 컨테이너가 초기화돼도 잃지 않도록 이것만 추적한다.
audio/*
!audio/raw_s1.wav
!audio/raw_s2.wav
!audio/raw_s3.wav
!audio/raw_s4.wav

# 납품물 중 가벼운 것만 추적
!out/thumbnail.jpg

