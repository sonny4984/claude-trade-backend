# 재생성 가능한 대용량 산출물은 저장소에 넣지 않는다
fonts/
stills/
hero_raw.png
out/*.mp4
out/*.png
out/*.mp3
out/*.log
out/diagnose.log

# 나레이션 원본은 크레딧 소진으로 재생성이 불가능하다.
# 컨테이너가 초기화돼도 잃지 않도록 이것만 추적한다.
audio/*
!audio/raw_s1.wav
!audio/raw_s2.wav
!audio/raw_s3.wav
!audio/raw_s4.wav
!audio/source.mp3
# 가공된 나레이션도 함께 지킨다. source.mp3 만 있으면 되살릴 수는 있지만,
# 컨테이너가 초기화될 때마다 옛 음원이 되살아나 그 위에서 작업하는 사고가 났다.
!audio/s1.wav
!audio/s2.wav
!audio/s3.wav
!audio/s4.wav

# 납품물 중 가벼운 것만 추적
!out/thumbnail.jpg

__pycache__/

# 인수인계 산출물은 make_handoff.py 로 다시 만들 수 있다
out/handoff/
out/pace.log

# 편집용 분리 트랙은 make_stems.py 로 다시 만들 수 있다
out/편집용/
out/*.png
audio/bed_bright.wav
out/*.jpg
plate_strip.png
